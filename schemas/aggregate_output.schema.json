              "enum": [
                "INPUT_MISSING_TITLE",
                "INPUT_MISSING_BODY",
                "INPUT_TOO_SHORT",
                "PRODUCT_NOT_FOUND",
                "PRODUCT_NAME_UNCLEAR",
                "MULTI_PRODUCT",
                "CONFLICTING_PRODUCT_TYPE_EVIDENCE",
                "HFF_DB_NO_MATCH",
