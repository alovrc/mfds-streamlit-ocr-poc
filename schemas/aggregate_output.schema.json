{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggregate_output.schema.json",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "stage1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "stage1_output.schema.json",
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_product_type": {
          "type": "string",
          "enum": [
            "HEALTH_FUNCTIONAL_FOOD",
            "FOOD",
            "FOOD_FALLBACK",
            "OUT_OF_SCOPE",
            "UNCERTAIN"
          ]
        },
        "product_presence": {
          "type": "boolean"
        },
        "multi_product": {
          "type": "boolean"
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product_index": {
                "type": "integer",
                "minimum": 0
              },
              "product_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "product_type": {
                "type": "string",
                "enum": [
                  "HEALTH_FUNCTIONAL_FOOD",
                  "FOOD",
                  "FOOD_FALLBACK",
                  "OUT_OF_SCOPE",
                  "UNCERTAIN"
                ]
              },
              "product_subtype": {
                "type": "string",
                "enum": [
                  "GENERAL_FOOD",
                  "FUNCTION_CLAIM_FOOD",
                  "SPECIAL_NUTRITION_FOOD",
                  "SPECIAL_MEDICAL_PURPOSE_FOOD",
                  "UNKNOWN_FOOD",
                  "NOT_APPLICABLE"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "analysis_target": {
                "type": "boolean"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "uncertainty_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "INPUT_MISSING_TITLE",
                    "INPUT_MISSING_BODY",
                    "INPUT_TOO_SHORT",
                    "PRODUCT_NOT_FOUND",
                    "PRODUCT_NAME_UNCLEAR",
                    "MULTI_PRODUCT",
                    "CONFLICTING_PRODUCT_TYPE_EVIDENCE",
                    "HFF_DB_NO_MATCH",
                    "HFF_DB_UNAVAILABLE",
                    "FILE_SEARCH_NOT_RUN",
                    "FILE_SEARCH_STORE_UNAVAILABLE",
                    "FILE_SEARCH_NO_RESULT",
                    "FILE_SEARCH_CITATION_MISSING",
                    "SEARCH_NO_RULE",
                    "SEARCH_NO_OFFICIAL_EVIDENCE",
                    "TRUNCATED_EVIDENCE",
                    "LEGAL_VERSION_UNVERIFIED",
                    "QUOTE_NOT_IN_SOURCE",
                    "RETRIEVED_ID_NOT_FOUND",
                    "EVIDENCE_CASE_TYPE_MISMATCH",
                    "JSON_SCHEMA_INVALID",
                    "RISK_SCORE_INVALID",
                    "RISK_AGGREGATION_MISMATCH",
