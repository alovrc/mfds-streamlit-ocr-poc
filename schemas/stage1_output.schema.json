{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_output.schema.json",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_product_type": {
      "type": "string",
      "enum": [
        "HEALTH_FUNCTIONAL_FOOD",
        "FOOD",
        "FOOD_FALLBACK",
        "OUT_OF_SCOPE",
        "UNCERTAIN"
      ]
    },
    "product_presence": {
      "type": "boolean"
    },
    "multi_product": {
      "type": "boolean"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_index": {
            "type": "integer",
            "minimum": 0
          },
          "product_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_type": {
            "type": "string",
            "enum": [
              "HEALTH_FUNCTIONAL_FOOD",
              "FOOD",
              "FOOD_FALLBACK",
              "OUT_OF_SCOPE",
              "UNCERTAIN"
            ]
          },
          "product_subtype": {
            "type": "string",
            "enum": [
              "GENERAL_FOOD",
              "FUNCTION_CLAIM_FOOD",
              "SPECIAL_NUTRITION_FOOD",
              "SPECIAL_MEDICAL_PURPOSE_FOOD",
              "UNKNOWN_FOOD",
              "NOT_APPLICABLE"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "food_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "hff_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "analysis_target": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INPUT_MISSING_TITLE",
                "INPUT_MISSING_BODY",
                "INPUT_TOO_SHORT",
                "PRODUCT_NOT_FOUND",
                "PRODUCT_NAME_UNCLEAR",
                "MULTI_PRODUCT",
                "CONFLICTING_PRODUCT_TYPE_EVIDENCE",
                "HFF_DB_NO_MATCH",
                "HFF_DB_UNAVAILABLE",
                "FILE_SEARCH_NOT_RUN",
                "FILE_SEARCH_STORE_UNAVAILABLE",
                "FILE_SEARCH_NO_RESULT",
                "FILE_SEARCH_CITATION_MISSING",
                "SEARCH_NO_RULE",
                "SEARCH_NO_OFFICIAL_EVIDENCE",
                "TRUNCATED_EVIDENCE",
                "LEGAL_VERSION_UNVERIFIED",
                "QUOTE_NOT_IN_SOURCE",
                "RETRIEVED_ID_NOT_FOUND",
                "EVIDENCE_CASE_TYPE_MISMATCH",
                "JSON_SCHEMA_INVALID",
                "RISK_SCORE_INVALID",
                "RISK_AGGREGATION_MISMATCH",
                "MODEL_REFUSAL_OR_EMPTY",
                "PROVIDER_TIMEOUT",
                "PROVIDER_MODEL_UNSUPPORTED"
              ]
            }
          }
        },
        "required": [
          "product_index",
          "product_name",
          "product_type",
          "product_subtype",
          "confidence",
          "food_confidence",
          "hff_confidence",
          "analysis_target",
          "evidence_ids",
          "uncertainty_codes"
        ],
        "additionalProperties": false
      }
    },
    "sales_ad_context": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "POSSIBLE",
        "NOT_CONFIRMED",
        "NOT_APPLICABLE"
      ]
    },
    "sales_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_target": {
      "type": "boolean"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_index": {
            "type": "integer",
            "minimum": 0
          },
          "stage2_route": {
            "type": "string",
            "enum": [
              "FOOD_REVIEW",
              "HFF_REVIEW",
              "NO_STAGE2"
            ]
          },
          "store_alias": {
            "type": "string",
            "enum": [
              "FS01_PRODUCT_GATE",
              "FS11_FOOD_REVIEW",
              "FS21_HFF_REVIEW"
            ]
          }
        },
        "required": [
          "product_index",
          "stage2_route",
          "store_alias"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "INPUT_MISSING_TITLE",
          "INPUT_MISSING_BODY",
          "INPUT_TOO_SHORT",
          "PRODUCT_NOT_FOUND",
          "PRODUCT_NAME_UNCLEAR",
          "MULTI_PRODUCT",
          "CONFLICTING_PRODUCT_TYPE_EVIDENCE",
          "HFF_DB_NO_MATCH",
          "HFF_DB_UNAVAILABLE",
          "FILE_SEARCH_NOT_RUN",
          "FILE_SEARCH_STORE_UNAVAILABLE",
          "FILE_SEARCH_NO_RESULT",
          "FILE_SEARCH_CITATION_MISSING",
          "SEARCH_NO_RULE",
          "SEARCH_NO_OFFICIAL_EVIDENCE",
          "TRUNCATED_EVIDENCE",
          "LEGAL_VERSION_UNVERIFIED",
          "QUOTE_NOT_IN_SOURCE",
          "RETRIEVED_ID_NOT_FOUND",
          "EVIDENCE_CASE_TYPE_MISMATCH",
          "JSON_SCHEMA_INVALID",
          "RISK_SCORE_INVALID",
          "RISK_AGGREGATION_MISMATCH",
          "MODEL_REFUSAL_OR_EMPTY",
          "PROVIDER_TIMEOUT",
          "PROVIDER_MODEL_UNSUPPORTED"
        ]
      }
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "short_reason": {
      "type": "string"
    },
    "file_search": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "offline"
          ]
        },
        "store_alias": {
          "type": "string",
          "enum": [
            "FS01_PRODUCT_GATE",
            "FS11_FOOD_REVIEW",
            "FS21_HFF_REVIEW"
          ]
        },
        "file_search_run": {
          "type": "boolean"
        },
        "search_query": {
          "type": "string"
        },
        "retrieved_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "file_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "excerpt": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1201
              }
            },
            "required": [
              "record_id",
              "file_name",
              "source",
              "page",
              "excerpt"
            ],
            "additionalProperties": false
          }
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "store_alias",
        "file_search_run",
        "search_query",
        "retrieved_ids",
        "citations",
        "latency_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_id",
    "record_product_type",
    "product_presence",
    "multi_product",
    "products",
    "sales_ad_context",
    "sales_signals",
    "analysis_target",
    "routes",
    "uncertainty_codes",
    "requires_human_review",
    "short_reason",
    "file_search"
  ],
  "additionalProperties": false
}
